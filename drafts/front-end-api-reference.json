{
  "name": "PixGen Front-End API Reference",
  "version": "0.1.0",
  "sourcePlan": "drafts/front-end-plan-draft.md",
  "basePath": "/api",
  "auth": {
    "strategy": "httpOnlyCookieSession",
    "frontendStorage": "Do not store JWTs in localStorage or sessionStorage.",
    "credentials": "include",
    "currentUserEndpoint": "GET /api/auth/me"
  },
  "generationBackend": {
    "frontendContract": "The front-end always calls the PixGen Spring API. It must not call the internal image service directly.",
    "simulationToggle": {
      "property": "app.internal-service-simulation",
      "true": "Server uses the simulated in-process generation strategy.",
      "false": "Server delegates generation to the internal service API strategy."
    },
    "publicEndpoints": [
      "GET /api/generation/models",
      "POST /api/jobs",
      "GET /api/jobs/{id}",
      "GET /api/jobs/me",
      "POST /api/jobs/{id}/cancel",
      "GET /api/jobs/stream",
      "GET /api/jobs/{id}/stream",
      "GET /api/images/{id}/file"
    ],
    "internalServiceEndpointsUsedByBackend": [
      "POST /api/v1/generate",
      "GET /api/v1/jobs/{job_id}/events",
      "GET /api/v1/jobs/{job_id}",
      "DELETE /api/v1/jobs/{job_id}",
      "GET /api/v1/jobs/{job_id}/image"
    ],
    "statusTracking": "Use PixGen SSE endpoints first. Fall back to GET /api/jobs/{id} polling if SSE is unavailable.",
    "artifactFlow": "The backend downloads the internal service PNG once and stores it locally; the front-end reads generated files through /api/images/{id}/file after the PixGen job succeeds."
  },
  "responseConventions": {
    "timestamps": "ISO-8601 strings",
    "nullableFields": "Fields omitted by the backend may be treated as null by the front-end.",
    "pageResponse": {
      "content": "array",
      "pageable": "object",
      "totalElements": "number",
      "totalPages": "number",
      "last": "boolean",
      "first": "boolean",
      "size": "number",
      "number": "number",
      "numberOfElements": "number",
      "empty": "boolean"
    },
    "errorResponse": {
      "timestamp": "string",
      "status": "number",
      "error": "string",
      "message": "string",
      "path": "string",
      "fieldErrors": "object|null"
    },
    "handledStatusCodes": [
      400,
      401,
      403,
      404,
      409,
      422,
      500
    ]
  },
  "enums": {
    "role": [
      "USER",
      "MODERATOR",
      "ADMIN"
    ],
    "jobStatus": [
      "PENDING",
      "RUNNING",
      "SUCCEEDED",
      "FAILED",
      "CANCELLED"
    ],
    "jobEventType": [
      "STATUS",
      "PROGRESS"
    ],
    "postStatus": [
      "DRAFT",
      "PUBLISHED",
      "ARCHIVED"
    ],
    "postVisibility": [
      "PUBLIC",
      "PRIVATE"
    ],
    "commentStatus": [
      "VISIBLE",
      "HIDDEN",
      "DELETED"
    ],
    "sort": [
      "createdAt,desc",
      "createdAt,asc",
      "updatedAt,desc",
      "updatedAt,asc",
      "commentCount,desc"
    ]
  },
  "schemas": {
    "User": {
      "id": "number",
      "email": "string",
      "username": "string",
      "verified": "boolean",
      "enabled": "boolean",
      "credits": "number",
      "role": "role",
      "createdAt": "string",
      "updatedAt": "string",
      "deletedAt": "string|null"
    },
    "UserStats": {
      "activeJobs": "number",
      "generatedImages": "number",
      "credits": "number"
    },
    "IncreaseCreditsRequest": {
      "amount": "number"
    },
    "LoginRequest": {
      "email": "string",
      "password": "string"
    },
    "RegisterRequest": {
      "email": "string",
      "password": "string",
      "username": "string"
    },
    "ForgotPasswordRequest": {
      "email": "string"
    },
    "ResetPasswordRequest": {
      "token": "uuid",
      "newPassword": "string"
    },
    "ChangePasswordRequest": {
      "currentPassword": "string",
      "newPassword": "string"
    },
    "GenerationModel": {
      "modelId": "string",
      "label": "string"
    },
    "CreateJobRequest": {
      "prompt": "string",
      "negativePrompt": "string|null",
      "width": "number|null",
      "height": "number|null",
      "numInferenceSteps": "number|null",
      "guidanceScale": "number|null",
      "seed": "number|null",
      "sampler": "string|null",
      "modelId": "string"
    },
    "Job": {
      "id": "number",
      "userId": "number",
      "status": "jobStatus",
      "prompt": "string",
      "negativePrompt": "string|null",
      "width": "number|null",
      "height": "number|null",
      "numInferenceSteps": "number|null",
      "guidanceScale": "number|null",
      "seed": "number|null",
      "sampler": "string|null",
      "modelId": "string",
      "internalServiceJobId": "string|null",
      "creditsCost": "number",
      "progress": "number",
      "cancelRequested": "boolean",
      "startedAt": "string|null",
      "completedAt": "string|null",
      "errorMessage": "string|null",
      "queuePosition": "number|null",
      "estimatedWaitMs": "number|null",
      "createdAt": "string",
      "updatedAt": "string"
    },
    "JobEvent": {
      "jobId": "number",
      "userId": "number",
      "type": "jobEventType",
      "status": "jobStatus|null",
      "progress": "number|null",
      "message": "string|null",
      "timestamp": "string"
    },
    "Image": {
      "id": "number",
      "userId": "number",
      "jobId": "number|null",
      "prompt": "string",
      "negativePrompt": "string|null",
      "mimeType": "string",
      "fileSizeBytes": "number",
      "width": "number",
      "height": "number",
      "modelId": "string",
      "sampler": "string|null",
      "numInferenceSteps": "number|null",
      "guidanceScale": "number|null",
      "seed": "number|null",
      "scheduler": "string|null",
      "clipSkip": "number|null",
      "lorasJson": "string|null",
      "extrasJson": "string|null",
      "createdAt": "string",
      "updatedAt": "string",
      "fileUrlTemplate": "/api/images/{id}/file"
    },
    "Author": {
      "id": "number",
      "username": "string",
      "profileImageUrl": "string|null",
      "createdAt": "string"
    },
    "CreatePostRequest": {
      "title": "string",
      "body": "string|null",
      "visibility": "postVisibility",
      "imageIds": "number[]"
    },
    "Post": {
      "id": "number",
      "userId": "number",
      "author": "Author|null",
      "authorUsername": "string|null",
      "username": "string|null",
      "title": "string",
      "body": "string|null",
      "status": "postStatus",
      "visibility": "postVisibility",
      "images": "Image[]",
      "createdAt": "string",
      "updatedAt": "string"
    },
    "CreateCommentRequest": {
      "parentId": "number|null",
      "body": "string"
    },
    "Comment": {
      "id": "number",
      "postId": "number",
      "userId": "number",
      "author": "Author|null",
      "authorUsername": "string|null",
      "username": "string|null",
      "parentId": "number|null",
      "path": "string",
      "depth": "number",
      "body": "string",
      "status": "commentStatus",
      "createdAt": "string",
      "updatedAt": "string"
    }
  },
  "frontendComposables": {
