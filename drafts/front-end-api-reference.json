    {
      "id": "jobs.cancel",
      "status": "implemented",
      "method": "POST",
      "path": "/api/jobs/{id}/cancel",
      "authRequired": true,
      "permission": "job.cancel",
      "pathParams": {
        "id": "number"
      },
      "request": null,
      "response": null,
      "successStatus": 204,
      "sideEffects": [
        "Attempts to cancel the PixGen job.",
        "For PENDING jobs, cancellation is applied before the worker starts.",
        "For RUNNING jobs, the worker observes the cancel request and transitions the job to CANCELLED when possible.",
        "When internal-service mode is enabled, the backend also attempts DELETE /api/v1/jobs/{job_id} against the internal service."
      ],
      "clientNotes": [
        "Treat 204 as cancellation requested, not as proof that the terminal CANCELLED event has already arrived.",
        "After calling cancel, continue listening to jobs.streamOne/jobs.streamMine or poll jobs.get until status is CANCELLED, FAILED, or SUCCEEDED."
      ],
      "frontEndPages": [
        "/dashboard/jobs",
        "/dashboard/jobs/[id]"
      ]
    },
    {
      "id": "jobs.streamMine",
      "status": "implemented",
      "method": "GET",
      "path": "/api/jobs/stream",
      "authRequired": true,
      "permission": "job.read",
      "transport": "serverSentEvents",
      "request": null,
      "response": "JobEvent",
      "successStatus": 200,
      "clientNotes": [
        "Primary stream for job progress updates across the current user's jobs.",
        "Use jobs.get polling as a fallback if the EventSource connection drops."
      ],
      "frontEndPages": [
        "/dashboard/jobs",
        "/dashboard/generate"
      ]
    },
    {
      "id": "jobs.streamOne",
      "status": "implemented",
      "method": "GET",
      "path": "/api/jobs/{id}/stream",
      "authRequired": true,
      "permission": "job.read",
      "transport": "serverSentEvents",
      "pathParams": {
        "id": "number"
      },
      "request": null,
      "response": "JobEvent",
      "successStatus": 200,
      "clientNotes": [
